# 2x2 tmux grid: top-left / top-right / bottom-left run `claude --chrome`,
# bottom-right is a plain zsh. Run `grid` to open or re-attach. Detach with
# Ctrl-b d; come back with `grid`.
grid() {
  local s=grid
  if ! tmux has-session -t "$s" 2>/dev/null; then
    tmux new-session -d -s "$s" -x 250 -y 60
    tmux send-keys    -t "$s" 'claude --chrome' Enter   # top-left
    tmux split-window -t "$s"
    tmux send-keys    -t "$s" 'claude --chrome' Enter   # top-right
    tmux split-window -t "$s"
    tmux send-keys    -t "$s" 'claude --chrome' Enter   # bottom-left
    tmux split-window -t "$s"                           # bottom-right: plain zsh
    tmux select-layout -t "$s" tiled
  fi
  tmux attach -t "$s"
}

# --- therdr: tmux+herdr combo so Claude Code AGENT TEAMS actually work -------
# The problem it solves: Claude Code's native teammate panes split *iTerm2's*
# session. Under herdr that's wrong twice over -- the split lands beside herdr
# instead of inside its pane system, and it usually fails outright with
# "Session '<uuid>' not found" because herdr shells are daemon-backed and
# survive iTerm2 restarts, leaving a stale inherited ITERM_SESSION_ID.
#
# Fix: run claude inside tmux, inside the herdr pane. Claude Code then has a
# tmux to split, so teammates become tmux panes *within this herdr pane* --
# visible where you're already looking, and real Agent-tool teammates (shared
# context, structured results, SendMessage) rather than separate CLIs being
# puppeteered.
#
#   therdr                # start/attach a claude team session for this dir
#   therdr --model opus   # extra args are passed through to claude
#
# Session is named per-directory, so re-running reattaches instead of stacking.
# Detach with Ctrl-b d; `therdr` again to come back.
# --teammate-mode is the load-bearing bit. Valid values are auto|tmux|iterm2|
# in-process. The default "auto" is wrong in both directions here: outside tmux
# it picks iterm2 and the spawn FAILS ("Session '<uuid>' not found"), and inside
# tmux it silently falls back to in-process -- teammates still work, but you
# never see them. Pinning "tmux" gets real teammates in panes you can watch.
therdr() {
  command -v tmux >/dev/null || { echo "therdr: tmux not installed" >&2; return 1; }

  # Layer 1: herdr. If we're not inside it there are no herdr panes to live in,
  # so hand off to herdr and let the user re-run therdr in a pane. (We can't
  # just wrap it: herdr takes over the terminal as a full-screen TUI.)
  if [ -z "$HERDR_ENV" ]; then
    echo "therdr: not inside herdr — starting it. Re-run 'therdr' in a herdr pane."
    command herdr
    return
  fi

  # Bypass permissions: teammates inherit the lead's mode, and shift+tab can
  # only cycle manual/accept-edits/plan -- "bypass permissions on" is
  # unreachable unless the process was LAUNCHED with the flag. Set
  # THERDR_NO_BYPASS=1 to opt out for a run.
  local -a perm
  [ -z "$THERDR_NO_BYPASS" ] && perm=(--dangerously-skip-permissions)

  # Layer 2: tmux, so Claude Code has panes to split for teammates.
  if [ -n "$TMUX" ]; then          # already inside tmux: nothing to set up
    command claude --teammate-mode tmux $perm "$@"
    return
  fi

  local s="therdr-${PWD:t}"
  if tmux has-session -t "$s" 2>/dev/null; then
    tmux attach -t "$s"
  else
    # Known tradeoff -- say it out loud so it isn't a surprise later.
    echo "therdr: teammates get visible panes, but herdr's sidebar will NOT"
    echo "        track this session (it binds agents by scanning the pane's"
    echo "        foreground process, and that process is now tmux). Run plain"
    echo "        'claude' instead if you want herdr agent tracking."
    # -A: attach if it raced into existence; keep the server alive per-session
    tmux new-session -A -s "$s" -n claude claude --teammate-mode tmux $perm "$@"
  fi
}

# --- spawning agents into a VISIBLE pane, under herdr ------------------------
# Use this when you want a SEPARATE agent you drive from outside (herdr agent
# prompt/read/send-keys). For real in-context teammates, use `therdr` above.
#
# Background (learned the hard way 2026-07-27):
#
# herdr is the workspace manager -- it owns the sidebar, spaces, tabs and panes
# you actually look at. It runs *inside* a single iTerm2 session. So the two
# obvious ways to give an agent a visible pane both fail here:
#
#   * `tmux new-session -d` -- runs fine but is DETACHED. Nothing is ever
#     attached to it, so the work happens off-screen. An agent can't fix this
#     itself: `tmux attach` needs a terminal the agent doesn't have.
#   * iTerm2 split panes (AppleScript, or Claude Code's native teammate panes)
#     -- these split iTerm2's session, producing a pane *beside* herdr, outside
#     its pane system entirely. Claude Code's teammate splits additionally fail
#     under herdr with "Session '<uuid>' not found": herdr shells are
#     daemon-backed and survive an iTerm2 restart, so the inherited
#     ITERM_SESSION_ID goes stale and no longer resolves.
#
# The right answer is to use herdr's own socket API, which is reachable from
# any subprocess (HERDR_* env vars are inherited, so agents can call it too):
#   herdr pane split / herdr agent start / prompt / read / send-keys / wait
#
#   agentpane <name> [cwd] [prompt]      # spawn a named claude in a new pane
#   agentpane arb ~/Code/income-bots "build X"
#
# Drive it afterwards with:
#   herdr agent read <name>              # see its screen
#   herdr agent send-keys <name> 2 enter # answer a permission prompt
#   herdr agent prompt <name> "..."      # send another instruction
agentpane() {
  local name="${1:?usage: agentpane <name> [cwd] [prompt]}"
  local cwd="${2:-$PWD}"
  local prompt="${3:-}"

  [ -n "$HERDR_ENV" ] || { echo "agentpane: not inside herdr" >&2; return 1; }

  local pane
  pane=$(herdr pane split --current --direction right --ratio 0.4 --cwd "$cwd" \
         | python3 -c 'import json,sys; print(json.load(sys.stdin)["result"]["pane"]["pane_id"])') || {
    echo "agentpane: split failed" >&2; return 1; }

  # A freshly split pane needs a moment before its shell accepts an agent;
  # herdr reports "agent_pane_busy: not an available shell" if we race it.
  local tries=0
  until herdr agent start "$name" --kind claude --pane "$pane" --timeout 90000 >/dev/null 2>&1; do
    tries=$((tries + 1))
    if [ "$tries" -ge 10 ]; then
      echo "agentpane: agent failed to start in $pane after $tries tries" >&2
      return 1
    fi
    sleep 2
  done

  [ -n "$prompt" ] && herdr agent prompt "$name" "$prompt" >/dev/null
  echo "agentpane: '$name' running in $pane (herdr agent read $name)"
}

